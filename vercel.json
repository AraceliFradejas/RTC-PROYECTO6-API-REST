{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "index.js"
    },
    {
      "src": "/(.*\\.(css|js|ico|png|jpg|svg|xml|txt))",
      "dest": "/frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}
